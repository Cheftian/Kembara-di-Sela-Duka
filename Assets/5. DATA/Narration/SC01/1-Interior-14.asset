  dialogueSteps:
  - characterName: Elara
    expressionName: Shocked
    dialogueEN: ASOIGFJAOSIDGJOID
    dialogueID: ASOIGFJAOSIDGJOID
  - characterName: Elara
    expressionName: Shocked
    dialogueEN: Did I just die??
    dialogueID: Aku barusan mati??
  - characterName: Elara
    expressionName: Shocked
    dialogueEN: Oh my god. No, no. I'm still here.
    dialogueID: Astaga. Nggak-nggak. Aku masih di sini.
  - characterName: Elara
    expressionName: Shocked
    dialogueEN: Whatever happens, I can't touch that fog. I have to run away immediately.
    dialogueID: Yang pasti aku gak boleh nyentuh kabut itu. Aku harus segera lari.
