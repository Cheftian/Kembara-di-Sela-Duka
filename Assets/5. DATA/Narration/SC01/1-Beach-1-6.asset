  dialogueSteps:
  - characterName: Elara
    expressionName: Happy
    dialogueEN: There. I'm out again.
    dialogueID: Nahh. Aku keluar lagi.
  - characterName: Elara
    expressionName: Happy
    dialogueEN: So the butterfly theory was right.
    dialogueID: Berarti teori kupu-kupu itu benar.
  - characterName: Elara
    expressionName: Questioning
    dialogueEN: Wait.
    dialogueID: Tunggu.
  - characterName: Elara
    expressionName: Questioning
    dialogueEN: But why is the swing's rope broken now?
    dialogueID: Tapi kenapa sekarang tali ayunannya putus?
  - characterName: Elara
    expressionName: Questioning
    dialogueEN: Didn't it feel like this when I arrived earlier?
    dialogueID: Perasaann tadi waktu nyampe gak gini?
  - characterName: Elara
    expressionName: Normal
    dialogueEN: I have to <b>fix the swing</b>.
    dialogueID: Aku harus <b>perbaiki ayunannya</b>
  loadSceneAfterNarration: 0
  sceneNameAfterNarration: 
