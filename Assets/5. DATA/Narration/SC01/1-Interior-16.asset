  dialogueSteps:
  - characterName: Elara
    expressionName: Questioning
    dialogueEN: Wait, I didn't imagine that, right?
    dialogueID: Eh, tadi aku gak salah lihat, kan?
  - characterName: Elara
    expressionName: Questioning
    dialogueEN: Was there a shadow that looked like me? Or was that me?
    dialogueID: Ada bayangan mirip aku? Ato itu aku?
  - characterName: Elara
    expressionName: Shocked
    dialogueEN: This place is getting more and more wrong. I have to get out immediately.
    dialogueID: Semakin gak bener tempat ini. Aku harus segera keluar.
  - characterName: Elara
    expressionName: Questioning
    dialogueEN: Where's the exit?
    dialogueID: Mana pintu keluarnya?
  loadSceneAfterNarration: 0
  sceneNameAfterNarration: 
