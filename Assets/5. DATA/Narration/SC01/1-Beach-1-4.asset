  dialogueSteps:
  - characterName: Elara
    expressionName: Shocked
    dialogueEN: ASGJASOIGJAOSIGJ
    dialogueID: ASGJASOIGJAOSIGJ
  - characterName: Elara
    expressionName: Angry
    dialogueEN: THIS PLACE IS SO WEIRD.
    dialogueID: GAKK ANEHH KOK TEMPAT INI.
  - characterName: Elara
    expressionName: Normal
    dialogueEN: Calm down, Lara. You must be tired.
    dialogueID: Tenang, Lara. Sepertinya kamu lelah.
  - characterName: Elara
    expressionName: Normal
    dialogueEN: As long as it hasn't happened three times, it probably means your
      head is just dizzy.
    dialogueID: Selagi belum 3 kali, brarti emang kepalamu yang lagi pusing.
  - characterName: Elara
    expressionName: Normal
    dialogueEN: Remember what happened earlier. I have to <b>follow the butterflies</b>.
    dialogueID: Inget cara tadi. Aku harus <b>ikutin kupu-kupu</b>.
  loadSceneAfterNarration: 0
  sceneNameAfterNarration: 
