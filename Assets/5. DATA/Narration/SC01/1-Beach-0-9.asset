  m_Script: {fileID: 11500000, guid: b0fa3e45e619d804fb1458038e5f0c13, type: 3}
  m_Name: 1-Beach-0-9
  m_EditorClassIdentifier: 
  dialogueSteps:
  - characterName: Elara
    expressionName: Happy
    dialogueEN: This is the moment.
    dialogueID: Ini saatnya.
  - characterName: Elara
    expressionName: '-'
    dialogueEN: '*locked*'
    dialogueID: '*terkunci'
  - characterName: Elara
    expressionName: Questioning
    dialogueEN: Huhh. Why is it locked? Dad isn't inside?
    dialogueID: Lahh. Kok kekunci? Ayah gak di dalem?
  - characterName: Nova
    expressionName: Normal
    dialogueEN: Your dad isn't here?
    dialogueID: Ayahmu gak ada?
  - characterName: Elara
    expressionName: Normal
    dialogueEN: Yeah. He's usually inside.
    dialogueID: Iya, loh. Biasanya dia di dalam.
  - characterName: Nova
    expressionName: Normal
    dialogueEN: Maybe he went out?
    dialogueID: Lagi keluar mungkin?
  - characterName: Elara
    expressionName: Normal
    dialogueEN: Yeah, maybe. I'll check the <b>left side of the beach</b> first.
    dialogueID: Iya kali ya? Aku coba cek di <b>sisi kiri pantai</b> dulu deh.
  - characterName: Elara
    expressionName: Normal
    dialogueEN: We used to play there a lot.
    dialogueID: Dulu kami sering main di sana.
  loadSceneAfterNarration: 0
  sceneNameAfterNarration: 
